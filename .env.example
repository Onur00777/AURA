# AURA — fully offline terminal chat (local GGUF LLM)

# ── LLM (local llama.cpp / GGUF) ─────────────────────
AURA_LLM_PROVIDER=local
# AURA_LLM_MODEL_PATH=models/your-model.Q4_K_M.gguf
AURA_LLM_MODEL=local-gguf
AURA_LLM_N_CTX=2048
AURA_LLM_N_BATCH=256
AURA_LLM_N_THREADS=0
AURA_LLM_N_GPU_LAYERS=0
AURA_LLM_MAX_TOKENS=256
AURA_LLM_TEMPERATURE=0.2

# Optional remote providers (not required):
# AURA_LLM_PROVIDER=gemini
# AURA_LLM_API_KEY=...
# AURA_LLM_MODEL=gemini-1.5-flash

# ── Misc ─────────────────────────────────────────────
AURA_LOG_LEVEL=INFO
